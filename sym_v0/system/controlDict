FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         20000; // 84s demora un recorredido completo -> 9 veces = 756s 

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      5;

writeFormat     ascii;

writePrecision  10; //6;

writeCompression on;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           0.5; //4;

maxDeltaT       0.1;


functions
{


    ageOfWater
    {
        type            scalarTransport;
        libs            ("libsolverFunctionObjects.so");
        field           AoW;

        enabled         true;
        writeControl    timeStep;
        writeInterval   1;


        // Difusión molecular (agua)
        D               1e-9;     // Ajustar según caso

        // Para flujo turbulento
        nut             nut;
        // Opcional: si querés controlar Sc_t
        turbulentSchmidt 0.7;

        fvOptions
        {
            unitySource
            {
                type            scalarSemiImplicitSource;
		enabled         true;
                selectionMode   all;
                volumeMode      specific;

                sources
                {
                    AoW (1 0);
                }
            }
        }
    }

secondMoment
{
    type            scalarTransport;
    libs            ("libsolverFunctionObjects.so");

    field           AoW2;

        enabled         true;
        writeControl    timeStep;
        writeInterval   1;

    D               1e-9;
    nut             nut;
    turbulentSchmidt 0.7;

    fvOptions
    {
        momentSource
        {
            type            scalarCodedSource;
            active          true;
	    name            AoW2Source;
            selectionMode   all;

            fields          (AoW2);


    codeAddSup
    #{
        const volScalarField& AoW =
            mesh().lookupObject<volScalarField>("AoW");

        forAll(eqn.source(), celli)
        {
            eqn.source()[celli] -=
                2.0 * AoW[celli] * mesh().V()[celli];
        }
    #};


    codeCorrect
    #{
        // Required by v2312 - leave empty
    #};

    codeConstrain
    #{
        // Required by v2312 - leave empty
    #};


        }
    }
}

